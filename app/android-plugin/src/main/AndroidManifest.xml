<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 桥接 WS 客户端网络访问 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 扫码配对（相机） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 前台服务保活（design.md 决策 7） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API 33+ 通知展示（前台服务在系统未授权时仍可运行） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 查询可启动应用列表（apps 能力） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <service
            android:name=".BridgeAccessibilityService"
            android:label="@string/bridge_service_label"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/bridge_accessibility_service_config" />
        </service>

        <!-- WS 连接保活前台服务（常驻通知） -->
        <service
            android:name=".BridgeForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 扫码配对页（zxing） -->
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />
    </application>
</manifest>
