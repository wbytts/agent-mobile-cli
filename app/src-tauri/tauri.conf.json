{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Mobile Bridge",
  "version": "0.1.0",
  "identifier": "com.agentmobile.bridge",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1430"
  },
  "app": {
    "windows": [
      {
        "title": "Agent Mobile Bridge",
        "width": 400,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
